# Публичный URL сайта (используется в metadata, Open Graph и sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — публичные значения (безопасны для клиента)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — секретный ключ. ТОЛЬКО для серверного кода. Не добавлять префикс NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot API — секретные значения. ТОЛЬКО для серверного кода.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
